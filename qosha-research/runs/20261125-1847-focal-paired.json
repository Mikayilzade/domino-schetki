  "reproduction": "function experiment(e,i,d,s,start=4000,count=2000){const names=['min-hand-pips','moderate-double-hold','fast-doubles'];const rows=names.map(name=>({name,n:0,w:0,p:0,turns:0,blocks:0,minus:{},hist:Array(55).fill(0),startD:Array(8).fill(0),endD:Array(8).fill(0),byDouble:Array.from({length:7},()=>({n:0,w:0,p:0}))}));let diff=0,diff2=0;for(let seed=start;seed<start+count;seed++){const base=i.initializeThreePlayerRound({seed,isFirstRound:false,previousWinnerIndex:seed%3});const deal=e.dealThreeByNine(seed);let delta=0;for(let seat=0;seat<3;seat++){const hand=deal.hands[seat];const wins=[];for(let k=0;k<names.length;k++){const m=rows[k];const out=d.runRound(base,(opts,state)=>s.chooseBy(state.currentPlayer===seat?names[k]:state.currentPlayer===(seat+1)%3?'random-legal':'min-hand-pips',opts,{seed,rotation:seat,turns:state.turns,player:state.currentPlayer}));const win=+(out.outcome.kind==='finish'&&out.outcome.playerIndex===seat),p=e.pipSum(out.hands[seat]);wins.push(win);m.n++;m.w+=win;m.p+=p;m.hist[p]=(m.hist[p]||0)+1;m.turns+=out.turns;m.blocks+=+(out.outcome.kind==='block');if(win){const key=String(out.outcome.minus||0);m.minus[key]=(m.minus[key]||0)+1;}m.startD[hand.filter(t=>t[0]===t[1]).length]++;m.endD[out.hands[seat].filter(t=>t[0]===t[1]).length]++;for(const t of hand)if(t[0]===t[1]){const z=m.byDouble[t[0]];z.n++;z.w+=win;z.p+=p;}}delta+=(wins[1]-wins[0])/3;}diff+=delta;diff2+=delta*delta;}return {start,count,rows,paired:{mean:diff/count,se:Math.sqrt((diff2-diff*diff/count)/(count-1)/count)}};}",
